# AI Provider selection: "openrouter" (default) or "nim"
AI_PROVIDER=nim

# OpenRouter API configuration (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# NVIDIA NIM API configuration (used when AI_PROVIDER=nim)
NIM_API_KEY=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
NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Voice Provider selection: "elevenlabs" (default) or "nim"
VOICE_PROVIDER=elevenlabs

# ElevenLabs API configuration (used when VOICE_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# NVIDIA NIM TTS configuration (used when VOICE_PROVIDER=nim)
NIM_TTS_MODEL=nvidia/tts-hifigan
NIM_TTS_VOICE=female

# Supabase Auth and private persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CELCIA_OWNER_EMAIL=your-authorized-email@example.com
APP_URL=http://localhost:8000

# Note: The OpenAI SDK is used as the client for both OpenRouter and NVIDIA NIM
# via their OpenAI-compatible APIs.